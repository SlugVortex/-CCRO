{
  "name": "caribbean-climate-resilience-orchestrator",
  "private": true,
  "version": "1.0.0",
  "description": "A multi-agent Caribbean climate resilience planning app for the Microsoft hackathon.",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "dev:api": "python -m uvicorn backend.app.main:app --reload --port 8000",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx}'",
    "test:api": "python -m unittest discover -s backend/tests"
  },
  "dependencies": {
    "@iconify/react": "^5.0.2",
    "apexcharts": "^3.52.0",
    "axios": "^1.7.7",
    "bootstrap": "^5.3.1",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-apexcharts": "^1.4.1",
    "react-bootstrap": "^2.10.4",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.26.2",
    "sass": "^1.77.8",
    "simplebar-core": "^1.2.6",
    "simplebar-react": "^3.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.0",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.3"
  }
}
